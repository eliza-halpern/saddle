{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deployment bundle",
  "description": "The shape of a bundle file, as one deployment tool's published JSON Schema reads it, exported once and committed here so the check needs no network.",
  "type": "object",
  "required": ["apiVersion", "resources"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": ["bundle/v1"]
    },
    "presets": {
      "type": "object",
      "description": "Named mappings a bundle merges into its jobs with `<<`."
    },
    "resources": {
      "type": "object",
      "required": ["jobs"],
      "additionalProperties": false,
      "properties": {
        "jobs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["tasks"],
            "additionalProperties": false,
            "properties": {
              "tasks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/task"
                }
              },
              "when": {
                "type": "array",
                "items": {
                  "enum": ["nightly", "weekly", "on-push"]
                }
              }
            }
          }
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "size"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": ["name", "run"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "run": {
          "type": "string"
        },
        "timeout": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

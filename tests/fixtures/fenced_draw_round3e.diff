+"""Multi-currency account ledger.
+
+REQ-003: Accounts hold per-currency Decimal balances. deposit/withdraw/
+transfer accept a currency (default USD). .balance returns the USD Decimal
+balance. .balances returns a dict copy. Over-withdrawal raises ValueError.
+Unsupported currency raises ValueError naming USD, EUR, and JPY. None or
+non-numeric amounts raise TypeError.
+"""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+from money import quantize, to_decimal, validate_currency
+
+
+def _zero_for(currency: str) -> Decimal:
+    """Return the quantized zero for a currency."""
+    if currency == "JPY":
+        return Decimal(0)
+    return Decimal("0.00")
+
+
+class Account:
+    """A multi-currency account with per-currency Decimal balances."""
+
+    def __init__(self, owner, balance=0.0):
+        if not owner:
+            raise ValueError("owner must be a non-empty string")
+        opening = quantize(to_decimal(balance), "USD")
+        if opening < 0:
+            raise ValueError("opening balance must be >= 0")
+        self.owner = owner
+        self._balances: dict[str, Decimal] = {"USD": opening}
+
+    @property
+    def balance(self) -> Decimal:
+        """Current USD balance as a Decimal."""
+        return self._balances.get("USD", Decimal("0.00"))
+
+    @property
+    def balances(self) -> dict[str, Decimal]:
+        """Return a copy of all per-currency balances."""
+        result = {}
+        for cur in ("USD", "EUR", "JPY"):
+            if cur in self._balances:
+                result[cur] = self._balances[cur]
+            else:
+                result[cur] = _zero_for(cur)
+        return result
+
+    def deposit(self, amount, currency="USD") -> Decimal:
+        """Add funds in the given currency; returns the new balance for that currency."""
+        validate_currency(currency)
+        value = quantize(to_decimal(amount), currency)
+        if value <= 0:
+            raise ValueError("deposit amount must be positive")
+        current = self._balances.get(currency, _zero_for(currency))
+        self._balances[currency] = current + value
+        return self._balances[currency]
+
+    def withdraw(self, amount, currency="USD") -> Decimal:
+        """Remove funds in the given currency; returns the new balance for that currency."""
+        validate_currency(currency)
+        value = quantize(to_decimal(amount), currency)
+        if value <= 0:
+            raise ValueError("withdrawal amount must be positive")
+        current = self._balances.get(currency, _zero_for(currency))
+        if value > current:
+            raise ValueError("insufficient funds")
+        self._balances[currency] = current - value
+        return self._balances[currency]
+
+    def to_dict(self):
+        """Serialize to the version-2 record schema."""
+        return {
+            "owner": self.owner,
+            "balances": {k: str(v) for k, v in self._balances.items()},
+        }
+
+    @classmethod
+    def from_dict(cls, data):
+        """Rebuild an account from a version-2 or version-1 record."""
+        acc = cls(data["owner"])
+        if "balances" in data:
+            for cur, val in data["balances"].items():
+                validate_currency(cur)
+                acc._balances[cur] = Decimal(val)
+        elif "balance" in data:
+            acc._balances["USD"] = quantize(to_decimal(data["balance"]), "USD")
+        return acc
+
+    def __eq__(self, other):
+        if not isinstance(other, Account):
+            return NotImplemented
+        return self.owner == other.owner and self._balances == other._balances
+
+    def __repr__(self):
+        return f"Account(owner={self.owner!r}, balances={self._balances})"
+
+
+def transfer(source, target, amount, currency="USD") -> Decimal:
+    """Move funds between two accounts in the given currency; returns the amount moved."""
+    validate_currency(currency)
+    value = quantize(to_decimal(amount), currency)
+    if value <= 0:
+        raise ValueError("transfer amount must be positive")
+    source.withdraw(value, currency)
+    target.deposit(value, currency)
+    return value

+"""Per-currency fee schedule.
+
+REQ-004: Each currency has a fixed fee. apply_fee quantizes the input,
+subtracts the fee, and returns the quantized Decimal net (raising ValueError
+when the quantized amount is below the fee). fee_for validates currency and
+type and returns the Decimal fee. total_fees returns the combined Decimal
+fees for count transactions (TypeError for non-int, ValueError for negative).
+"""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+from money import quantize, to_decimal, validate_currency
+
+FEES = {"USD": Decimal("0.30"), "EUR": Decimal("0.25"), "JPY": Decimal("30")}
+
+
+def fee_for(amount, currency="USD") -> Decimal:
+    """Return the fee for a transaction in the given currency.
+
+    Validates currency and amount type; returns the fixed Decimal fee.
+    """
+    validate_currency(currency)
+    to_decimal(amount)
+    return FEES[currency]
+
+
+def apply_fee(amount, currency="USD") -> Decimal:
+    """Deduct the fee for the given currency; returns the quantized net amount.
+
+    Raises ValueError when the quantized amount is below the fee.
+    """
+    validate_currency(currency)
+    value = quantize(to_decimal(amount), currency)
+    fee = FEES[currency]
+    if value < fee:
+        raise ValueError(
+            f"amount {value} is below the fee {fee} for {currency}"
+        )
+    net = value - fee
+    return quantize(net, currency)
+
+
+def total_fees(count, currency="USD") -> Decimal:
+    """Return the combined fees for count transactions in the given currency.
+
+    Raises TypeError for non-int counts, ValueError for negative counts.
+    """
+    validate_currency(currency)
+    if isinstance(count, bool) or not isinstance(count, int):
+        raise TypeError("count must be an int")
+    if count < 0:
+        raise ValueError("count must be >= 0")
+    return quantize(FEES[currency] * count, currency)

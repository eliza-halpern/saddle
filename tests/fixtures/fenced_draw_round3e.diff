+"""Shared money helpers: type conversion, rounding, and currency validation.
+
+REQ-002: Provides the single money concept used across accounts, fees,
+report, and store. Converts int/str/Decimal/float to Decimal (floats via
+Decimal(str(value))), quantizes with ROUND_HALF_UP to 2dp for USD/EUR and
+0dp for JPY, and validates currency raising ValueError naming USD, EUR,
+and JPY for unsupported values.
+"""
+
+from __future__ import annotations
+
+from decimal import Decimal, ROUND_HALF_UP
+
+SUPPORTED_CURRENCIES = ("USD", "EUR", "JPY")
+
+
+def validate_currency(currency: str) -> str:
+    """Validate that currency is one of the supported currencies.
+
+    Raises ValueError naming USD, EUR, and JPY for anything else.
+    """
+    if currency not in SUPPORTED_CURRENCIES:
+        raise ValueError(
+            f"unsupported currency {currency!r}; supported currencies are USD, EUR, JPY"
+        )
+    return currency
+
+
+def to_decimal(value) -> Decimal:
+    """Convert int, str, Decimal, or float to Decimal.
+
+    Floats are converted via Decimal(str(value)) to avoid binary float
+    artifacts. Raises TypeError for any other type (including bool).
+    """
+    if isinstance(value, bool):
+        raise TypeError(f"unsupported type for amount: {type(value).__name__}")
+    if isinstance(value, Decimal):
+        return value
+    if isinstance(value, int):
+        return Decimal(value)
+    if isinstance(value, str):
+        return Decimal(value)
+    if isinstance(value, float):
+        return Decimal(str(value))
+    raise TypeError(f"unsupported type for amount: {type(value).__name__}")
+
+
+def quantize(amount: Decimal, currency: str) -> Decimal:
+    """Quantize a Decimal to the appropriate places for the given currency.
+
+    USD and EUR: 2 decimal places. JPY: 0 decimal places.
+    Uses ROUND_HALF_UP.
+    """
+    validate_currency(currency)
+    if currency == "JPY":
+        return amount.quantize(Decimal(1), rounding=ROUND_HALF_UP)
+    return amount.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
